            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ganesh@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/calnest/forgot-password" }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ganesh@example.com\",\n  \"code\": \"123456\",\n  \"password\": \"newpass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/calnest/reset-password" }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ganesh@example.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/calnest/verify-email" }
          }
        },
        {
          "name": "Delete Account (Compliance)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/calnest/me" }
          }
        }
      ]
    },
